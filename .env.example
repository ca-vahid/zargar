# Copy to backend/.env and fill in. All variables are optional in dev —
# the app runs fully simulated with none of them set.

# --- database (docker compose default) --------------------------------------
ZARGAR_DATABASE_URL=postgresql+asyncpg://zargar:zargar@127.0.0.1:5432/zargar

# --- broker ------------------------------------------------------------------
# "sim" (default): simulated quotes + local fill engine, no IBKR needed.
# "ibkr": connect to IB Gateway (requires `pip install -e .[ibkr]`).
ZARGAR_BROKER=sim
ZARGAR_IBKR_HOST=127.0.0.1
ZARGAR_IBKR_PORT=4002          # 4002 gateway paper, 4001 gateway live, 7497 TWS paper
ZARGAR_IBKR_CLIENT_ID=17

# --- snaptrade (Wealthsimple / Webull) ----------------------------------------
# Personal API credentials from https://dashboard.snaptrade.com (API Key page).
# Verify + upgrade connections: python -m zargar.tools.snaptrade_check --upgrade
ZARGAR_SNAPTRADE_CLIENT_ID=
ZARGAR_SNAPTRADE_CONSUMER_KEY=

# --- signal extraction (Claude API) ------------------------------------------
# Without a key, ingestion still stores emails; extraction is skipped.
ZARGAR_ANTHROPIC_API_KEY=
ZARGAR_EXTRACTION_MODEL=claude-opus-5

# Options chains for the technique pipeline (T5). Optional: the default provider
# is CBOE's free delayed endpoint, which needs no credentials and works outside
# the US. Set these only if you have a Tradier account (US-address signup) and
# switch technique.options.provider to "tradier" in Settings.
ZARGAR_TRADIER_TOKEN=
ZARGAR_TRADIER_SANDBOX=false

# --- inbound email webhook -----------------------------------------------------
# Shared secret the Cloudflare Email Worker must send as X-Zargar-Ingest-Key.
ZARGAR_INGEST_KEY=

# --- telegram approvals -------------------------------------------------------
# Create a bot with @BotFather, get your chat id from @userinfobot,
# then enable the telegram.enabled toggle in Settings.
ZARGAR_TELEGRAM_BOT_TOKEN=
ZARGAR_TELEGRAM_CHAT_ID=

# --- api server ----------------------------------------------------------------
ZARGAR_HOST=127.0.0.1
ZARGAR_PORT=8420
# Set to require Bearer auth on the API + WS (recommended when exposed via Tailscale).
ZARGAR_AUTH_TOKEN=
# Serve the built frontend from the backend (path to frontend/dist).
ZARGAR_FRONTEND_DIST=
